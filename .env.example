# ===== DocuForge 환경 변수 예시 =====
# 각 서버 실행 전 필요한 값을 복사해 .env 로 사용한다.

# --- AI Server (FastAPI, :8000) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# 비워두면 키워드(TF-IDF) 검색, 값을 넣으면 Ollama 임베딩 검색 (예: bge-m3)
OLLAMA_EMBED_MODEL=
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300
AI_DATA_DIR=./data
MAX_UPLOAD_MB=10

# --- Backend (Rails, :3000) ---
AI_SERVER_URL=http://localhost:8000
AI_SERVER_TIMEOUT=600
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_HOST=localhost
DATABASE_PORT=5432
# 로컬에 설치한 PostgreSQL의 postgres 비밀번호가 다르면 전용 계정을 만들어 지정한다.
# (CREATE ROLE docuforge LOGIN CREATEDB PASSWORD 'docuforge';) Rails는 dotenv-rails로 이 파일을 읽는다.
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Frontend (Vue, :5173) ---
VITE_API_BASE_URL=http://localhost:3000
